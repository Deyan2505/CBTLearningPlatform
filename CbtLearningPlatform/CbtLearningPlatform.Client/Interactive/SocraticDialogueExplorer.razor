@* Interactive WebAssembly island. Adapted from CbtModelDiagram/CognitiveHierarchyExplorer's
   proven step-select pattern (native <button> elements, aria-current="step", text fallback) —
   reuses the .cbt-diagram button/explanation/fallback CSS wholesale, no new styles needed. One
   fixed, neutral scenario carried through all 5 steps — not a free-text/personal-situation
   input, no storage, no scoring, no AI/API, no automatically generated advice. *@

<div class="cbt-diagram">
    <div class="card">
        <p><strong>Ситуация:</strong> Изпращате подготвен материал и получавате кратък отговор: „Ще го обсъдим утре.“</p>
        <p><strong>Първоначална мисъл:</strong> „Сигурно материалът е лош.“</p>
    </div>

    <ol class="cbt-diagram__steps" aria-label="Стъпки на сократическото изследване">
        @for (int i = 0; i < Steps.Count; i++)
        {
            int index = i;
            <li class="cbt-diagram__step-item">
                <button type="button"
                        class="cbt-diagram__step @(_selected == index ? "is-selected" : "")"
                        aria-current="@(_selected == index ? "step" : null)"
                        @onclick="() => Select(index)">
                    <span class="cbt-diagram__step-number">@(index + 1)</span>
                    <span class="cbt-diagram__step-label">@Steps[index].Label</span>
                </button>
            </li>
            if (index < Steps.Count - 1)
            {
                <li class="cbt-diagram__step-connector" aria-hidden="true">
                    <svg viewBox="0 0 20 8" width="20" height="8"><path d="M0 4h16m0 0-4-3.5m4 3.5-4 3.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </li>
            }
        }
    </ol>

    <div class="cbt-diagram__explanation" aria-live="polite">
        <h3>@Steps[_selected].Label</h3>
        @if (Steps[_selected].Questions.Count > 0)
        {
            <ul>
                @foreach (string question in Steps[_selected].Questions)
                {
                    <li>@question</li>
                }
            </ul>
        }
        <p>@Steps[_selected].Explanation</p>
    </div>

    <details class="cbt-diagram__fallback">
        <summary>Текстово описание на всички стъпки</summary>
        <ol>
            @foreach (SocraticStep step in Steps)
            {
                <li>
                    <strong>@step.Label:</strong>
                    @if (step.Questions.Count > 0)
                    {
                        <text> @string.Join(" ", step.Questions)</text>
                    }
                    @step.Explanation
                </li>
            }
        </ol>
    </details>
</div>

@code {
    private int _selected;

    private static readonly IReadOnlyList<SocraticStep> Steps =
    [
        new("Изясняване",
            ["Какво точно означава „лош“?", "Какво очаквате да се случи?"],
            "Изясняването на неясната дума помага да забележим какво точно приемаме за вярно, преди да сме го проверили."),
        new("Доказателства",
            ["Какво в отговора директно показва отрицателна оценка?", "Има ли липсваща информация?"],
            "Самият отговор не съдържа дума или оценка — той просто отлага разговора във времето."),
        new("Алтернативи",
            ["Възможно ли е човекът просто да няма време в момента?", "Възможно ли е обсъждането да е нормална част от процеса?"],
            "Съществуват няколко правдоподобни обяснения, различни от първоначалната мисъл."),
        new("Последствия",
            ["Какво би последвало, ако има нужда от корекция?", "Има ли начин материалът да бъде подобрен?"],
            "Дори при нужда от корекции съществува ясен следващ стъпка — това не е неуправляем изход."),
        new("Балансирано заключение",
            [],
            "„Краткият отговор не показва каква е оценката. Възможно е да има корекции, но ще разбера повече при разговора.“")
    ];

    private void Select(int index) => _selected = index;

    private sealed record SocraticStep(string Label, IReadOnlyList<string> Questions, string Explanation);
}
