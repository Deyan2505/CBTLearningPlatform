@* Weekly Course Hub. Metadata comes entirely from CourseCatalog (Curriculum/CourseCatalog.cs) —
   no lesson text duplicated here. Only Weeks 1, 3, 6, 8, 10 and 12 have a real Route; every other
   week intentionally has Route=null so this page never links to a page that doesn't exist yet.
   Week 12 is AcademicContextOnly, so it resolves to AcademicOverview status rather than Available —
   the start-panel below still lists only the five Available weeks, since AcademicOverview is a
   different, non-self-guided category. Main hub area uses a wide/narrow two-column learning-grid
   (timeline left, contextual panel right) — not sticky, to avoid footer-overlap and zoom/
   accessibility risk for modest benefit. Course-progress bar + per-week done marker (MVP
   progress feature) read learner-local completion via CourseProgressService — localStorage only,
   no backend, no account; only CourseWeekDefinition.Number, never lesson content, is stored. *@
@page "/kurs"
@inject CourseProgressService Progress

<PageTitle>15-седмичен курс по основи на КПТ — КПТ Академия</PageTitle>

<div class="content">
    <p class="week-page__eyebrow">Обучителна програма · Курс</p>
    <h1>15-седмичен курс по основи на КПТ</h1>
    <p>
        Курсът очертава пълния академичен обхват на темата в 15 седмици — от историческите основи
        на когнитивния модел до по-новите направления в КПТ традицията. Платформата е образователна
        за широка публика, не университетски курс с кредити или диплома.
    </p>

    <ProgressiveExplanation SummaryLabel="Какво точно е налично сега?">
        <p>
            Пълната 15-седмична програма показва цялостния академичен план на темата. Курсът се изгражда
            поетапно — платформата предлага реално, напълно разработено съдържание само за част от
            седмиците, всяка от които е представителен съдържателен срез, не финалната версия на цялата
            програма. Статусът до всяка седмица по-долу показва честно кое е налично, кое е само академичен
            обзор и кое все още предстои. Нито една седмица не води към страница, която не съществува.
        </p>
    </ProgressiveExplanation>
</div>

<div class="workspace">
    <h2>Карта на курса</h2>
    <div class="course-map">
        @for (int i = 0; i < CourseCatalog.Modules.Count; i++)
        {
            CourseModule module = CourseCatalog.Modules[i];
            int weekCount = CourseCatalog.Weeks.Count(w => w.ModuleLabel == module.Title);
            <div class="course-map__block">
                <p class="course-map__range">@module.WeekRangeLabel</p>
                <h3>@module.Title</h3>
                <p>@module.Description</p>
                <p class="course-map__meta">@weekCount седмици</p>
            </div>
            if (i < CourseCatalog.Modules.Count - 1)
            {
                <span class="course-map__connector" aria-hidden="true">→</span>
            }
        }
    </div>
    <p><a href="/kurs/karta">Пълна интерактивна карта на курса и на знанието по КПТ →</a></p>

    <div class="learning-grid learning-grid--wide-narrow">
        <div>
            <h2>Седмици</h2>

            <div class="course-progress">
                <div class="course-progress__header">
                    <span>Напредък в курса</span>
                    <span>@_summary.CompletedCount / @_summary.TotalWeeks седмици (@_summary.PercentageComplete%)</span>
                </div>
                <progress class="course-progress__bar" value="@_summary.CompletedCount" max="@_summary.TotalWeeks">
                    @_summary.PercentageComplete%
                </progress>
            </div>

            <ol class="week-timeline" aria-label="Хронологичен списък на седмиците от курса">
                @foreach (CourseWeekDefinition week in CourseCatalog.Weeks)
                {
                    <li class="week-timeline__item">
                        <span class="week-timeline__connector" aria-hidden="true"></span>
                        <div class="week-timeline__marker" aria-hidden="true">@week.Number</div>
                        <div class="week-timeline__body card">
                            <div class="week-list__header">
                                <span class="week-list__number">Седмица @week.Number</span>
                                @if (_completedWeeks.Contains(week.Number))
                                {
                                    <span class="week-list__status week-list__status--done">✓ Завършена</span>
                                }
                                <span class="week-list__status week-list__status--@week.Status.ToStatusModifier()">
                                    @week.Status.ToPublicLabel()
                                </span>
                            </div>
                            <h3 class="week-list__title">
                                @if (week.Route is not null)
                                {
                                    <a href="@week.Route">@week.Title</a>
                                }
                                else
                                {
                                    @week.Title
                                }
                            </h3>
                            <p class="week-list__module">@week.ModuleLabel</p>
                            <p>@week.ShortSummary</p>
                            @if (week.InteractiveFormats.Count > 0)
                            {
                                <p class="week-list__formats">Интерактивност: @string.Join(" · ", week.InteractiveFormats.Select(f => f.ToPublicLabel()))</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>

        <div class="hub-sidebar">
            <div class="card start-panel">
                <h3>Откъде да започнете</h3>
                <p>
                    Пет седмици са напълно разработени и достъпни точно сега — курсът се изгражда поетапно,
                    всяка от тях е представителен съдържателен срез, не завършена цялостна програма:
                </p>
                <p>
                    <a class="btn btn-violet" href="/kurs/sedmica-1">Седмица 1 — Как се ражда когнитивната терапия</a>
                    (историческо въведение),
                    <a class="btn btn-violet" href="/kurs/sedmica-3">Седмица 3 — Архитектура на когнитивния модел</a>
                    (концепция и диаграма),
                    <a class="btn btn-violet" href="/kurs/sedmica-6">Седмица 6 — Структура на терапевтичната сесия</a>
                    (информационна демонстрация),
                    <a class="btn btn-violet" href="/kurs/sedmica-8">Седмица 8 — Автоматични мисли и емоции</a>
                    (симулаторен формат) и
                    <a class="btn btn-violet" href="/kurs/sedmica-10">Седмица 10 — Сократически въпроси и съвместно изследване</a>
                    (насочено упражнение).
                </p>
                <p>Останалите 10 седмици представят пълния академичен пътен план на курса, не завършено съдържание.</p>
            </div>

            <div class="card">
                <h3>Статуси</h3>
                <dl class="hub-sidebar__legend">
                    <div><dt>Налично</dt><dd>напълно разработена страница</dd></div>
                    <div><dt>В подготовка</dt><dd>планирана, все още не е написана</dd></div>
                    <div><dt>Академичен обзор</dt><dd>само общ преглед, не self-guided</dd></div>
                    <div><dt>Изисква професионален преглед</dt><dd>блокирано без клиничен преглед</dd></div>
                </dl>
            </div>

            <div class="card">
                <h3>Видове интерактивност</h3>
                <dl class="hub-sidebar__legend">
                    <div><dt>Симулатор</dt><dd>контроли + live резултат</dd></div>
                    <div><dt>Интерактивен модел</dt><dd>изследване на структура/йерархия</dd></div>
                    <div><dt>Сравнение</dt><dd>две гледни точки едновременно</dd></div>
                    <div><dt>Демонстрация</dt><dd>управляван, стъпков преглед</dd></div>
                    <div><dt>Академичен преглед</dt><dd>текст, без self-guided инструмент</dd></div>
                </dl>
            </div>

            <div class="card">
                <h3>Как се използва курсът</h3>
                <p>Разгледайте картата на курса и списъка със седмици, после отворете някоя от наличните — всяка представя различен учебен формат.</p>
            </div>

            <DisclaimerCallout />
        </div>
    </div>
</div>

@code {
    private IReadOnlySet<int> _completedWeeks = new HashSet<int>();
    private CourseProgressSummary _summary = new(0, CourseCatalog.Weeks.Count, 0);

    protected override async Task OnInitializedAsync()
    {
        _completedWeeks = await Progress.GetCompletedWeekNumbersAsync();
        _summary = CourseProgressCalculator.Summarize(CourseCatalog.Weeks, _completedWeeks);
    }
}
