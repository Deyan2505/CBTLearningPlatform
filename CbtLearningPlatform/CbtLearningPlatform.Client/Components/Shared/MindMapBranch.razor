@* Recursive node renderer for ConceptGraph's MindMap mode — same GraphRenderNode data, two
   responsive representations, no duplication (COGNITIVE_LEARNING_ARCHITECTURE_v1.md §8/§9, owner
   visual correction pass 2). Narrow containers: a vertical outline tree (details/summary stacked,
   children indented below — kept exactly as the prior pass, still the mobile/accessibility-first
   representation). Wide containers (@container min-width, see app.css): the SAME markup reflows
   into a left-to-right spatial branching layout — <details> becomes a flex row (summary | its
   children-column), so children fan out to the right of their parent instead of stacking below it.
   No JavaScript/WASM: the reflow is pure CSS, and the curved "elbow" connector technique (border +
   border-radius, see app.css) doesn't care which direction the flex row runs, so it stays correct
   at every width without recomputing coordinates.

   Nodes are compact by design (§9 of the correction pass): label only, no inline sub-description —
   the fuller explanation already lives in the linked section itself, not duplicated here. A leaf
   node with an anchor is a single link (unambiguous — nothing to expand). A branch's <summary> is
   toggle-only — no nested link. An earlier pass nested a "→" goto affordance inside <summary> for
   branches too, reasoning a click on it would navigate away regardless of any incidental toggle;
   that assumption broke for same-page anchors (every Anchor here is `/kurs/sedmica-N#...` on the
   page the map already lives on), where "navigating" is just an in-page scroll-jump, so a click on
   the arrow/header jumped down the page instead of expanding — confirmed by owner interaction
   testing on Week 8. Branches now only ever toggle; reaching a section happens via its actual leaf
   nodes (or the page's own section navigator), never from a cluster header. *@
@namespace CbtLearningPlatform.Client.Components.Shared
@using CbtLearningPlatform.Client.Curriculum

@{
    var children = AllNodes.Where(n => n.ParentId == Node.Id).ToList();
    var depthClass = $"mindmap-node--depth-{Math.Min(Depth, 3)}";
    var stateClass = $"concept-graph__node--{StateClass(Node.DisplayState)}";
}

@if (children.Count == 0)
{
    if (!string.IsNullOrWhiteSpace(Node.Anchor))
    {
        <a class="mindmap-node @depthClass mindmap-node--leaf @stateClass" href="@Node.Anchor">
            <span class="concept-graph__node-label">@Node.Label</span>
        </a>
    }
    else
    {
        <div class="mindmap-node @depthClass mindmap-node--leaf @stateClass">
            <span class="concept-graph__node-label">@Node.Label</span>
        </div>
    }
}
else
{
    <details class="mindmap-branch">
        <summary class="mindmap-branch__summary @depthClass @stateClass">
            <span class="mindmap-branch__chevron" aria-hidden="true"></span>
            <span class="concept-graph__node-label">@Node.Label</span>
        </summary>
        <ul class="mindmap-branch__children">
            @foreach (var child in children)
            {
                <li>
                    <MindMapBranch Node="child" AllNodes="AllNodes" Depth="Depth + 1" />
                </li>
            }
        </ul>
    </details>
}

@code {
    [Parameter, EditorRequired]
    public GraphRenderNode Node { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<GraphRenderNode> AllNodes { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; } = 1;

    private static string StateClass(ConceptState? state) => state switch
    {
        ConceptState.Upcoming => "upcoming",
        ConceptState.Revisited => "revisited",
        ConceptState.Introduced => "introduced",
        _ => "instance"
    };
}
