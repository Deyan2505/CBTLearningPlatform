@page "/Error"
@using System.Diagnostics

<PageTitle>Грешка</PageTitle>

<h1>Възникна неочакван проблем</h1>
<p>Съжаляваме за неудобството. Опитайте отново или се върнете към <a href="/">началната страница</a>.</p>

@if (ShowRequestId)
{
    <p>
        <small>Референтен номер: <code>@RequestId</code></small>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
