@* Domain-ignorant rendering engine (COGNITIVE_LEARNING_ARCHITECTURE_v1.md §9) — knows nothing about
   automatic thoughts, core beliefs, Ирина, or Week 6. It only reads GraphRenderNode/GraphRenderEdge,
   produced by MindMapAdapter/ConceptMapAdapter/CaseConceptualizationAdapter. Static SSR by default — no
   @rendermode here, so it inherits whatever the host page uses (owner decision: Static SSR default,
   COGNITIVE_LEARNING_ARCHITECTURE_v1.md §21). MindMap mode delegates to the recursive MindMapBranch
   child component — a real spatial tree (root, then arbitrary-depth <details>-based branches), not a
   card grid; ConceptMap/CaseMap mode keeps the chain-with-connector layout, unchanged by the visual
   correction pass. *@
@namespace CbtLearningPlatform.Components.Shared
@using CbtLearningPlatform.Curriculum

<section class="concept-graph concept-graph--@ModeClass" aria-labelledby="@_titleId">
    <h4 id="@_titleId" class="concept-graph__title">@Model.Title</h4>
    @if (!string.IsNullOrWhiteSpace(Model.ScreenReaderSummary))
    {
        <p class="concept-graph__summary">@Model.ScreenReaderSummary</p>
    }

    @if (Model.Mode == ConceptGraphMode.MindMap)
    {
        var root = Model.Nodes.FirstOrDefault(n => n.ParentId is null);
        var primaryBranches = Model.Nodes.Where(n => n.ParentId == root?.Id).ToList();

        <div class="mindmap-tree">
            @if (root is not null)
            {
                <div class="mindmap-root">@root.Label</div>
            }
            <ul class="mindmap-branch__children mindmap-branch__children--top">
                @foreach (var node in primaryBranches)
                {
                    <li>
                        <MindMapBranch Node="node" AllNodes="Model.Nodes" Depth="1" />
                    </li>
                }
            </ul>
        </div>

        @* The tree above IS the accessible representation — native <details>/<summary> disclosure,
           real nested <ul>/<li>, one screen-reader-navigable structure. A second, flattened text
           description would duplicate it, not back it up, so MindMap mode skips the generic
           fallback below (used by ConceptMap/CaseMap, whose chain+cross-reference layout benefits
           from a plain-prose alternative). *@
    }
    else if (Model.Layout == ConceptGraphLayout.Network)
    {
        @* Spatial network layout (owner correction pass — the chain+cross-ref-list layout below could not
           show a node's several incoming/outgoing relations at once). Nodes are grouped into presentation
           clusters (GraphRenderNode.Cluster, supplied by the adapter, meaningless to this component) laid
           out as CSS Grid columns — real desktop width, not one narrow vertical strip. Every relation is
           rendered as a labeled chip directly on its source node's own card, so a node with five incoming
           edges is fully visible instead of capped at one connector, and a relation whose target sits in a
           different cluster gets a distinct "cross" style plus a same-page anchor jump to that card. The
           connecting line between stacked cards in one cluster is decorative (reusing the mind map's proven
           CSS-elbow technique, no SVG/coordinate math) — it reinforces that the cluster is one connected
           group; the relation LABEL itself lives in the adjacent chip, not on the line. CSS Grid's own
           auto-fit reflow (no extra media query needed) collapses clusters to a single stacked column on
           narrow viewports. *@
        var clusterOrder = Model.Nodes.Select(n => n.Cluster ?? "").Distinct().ToList();

        <div class="concept-graph__network">
            @foreach (var cluster in clusterOrder)
            {
                var clusterNodes = Model.Nodes.Where(n => (n.Cluster ?? "") == cluster).ToList();
                <div class="concept-graph__cluster">
                    @if (!string.IsNullOrWhiteSpace(cluster))
                    {
                        <h5 class="concept-graph__cluster-label">@cluster</h5>
                    }
                    <ul class="concept-graph__network-list">
                        @foreach (var node in clusterNodes)
                        {
                            var outgoing = Model.Edges.Where(e => e.FromId == node.Id).ToList();
                            <li>
                                <div id="@($"{ComponentId}-node-{node.Id}")" class="concept-graph__node concept-graph__network-node concept-graph__node--@StateClass(node.DisplayState)">
                                    @if (!string.IsNullOrWhiteSpace(node.Anchor))
                                    {
                                        <a class="concept-graph__node-label" href="@node.Anchor">@node.Label</a>
                                    }
                                    else
                                    {
                                        <span class="concept-graph__node-label">@node.Label</span>
                                    }
                                    @if (outgoing.Count > 0)
                                    {
                                        <ul class="concept-graph__network-edges">
                                            @foreach (var edge in outgoing)
                                            {
                                                var target = Model.Nodes.FirstOrDefault(n => n.Id == edge.ToId);
                                                var crossCluster = target is not null && (target.Cluster ?? "") != (node.Cluster ?? "");
                                                <li class="concept-graph__network-edge@(crossCluster ? " concept-graph__network-edge--cross" : "")">
                                                    <span class="concept-graph__edge-label">@edge.Label</span>
                                                    <a href="@($"#{ComponentId}-node-{edge.ToId}")">@(target?.Label ?? edge.ToId)</a>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <details class="concept-graph__fallback">
            <summary>Текстово описание на картата</summary>
            <ul class="concept-graph__fallback-list">
                @foreach (var node in Model.Nodes)
                {
                    var outgoing = Model.Edges.Where(e => e.FromId == node.Id).ToList();
                    <li>
                        <strong>@node.Label</strong>@(!string.IsNullOrWhiteSpace(node.ShortDefinition) ? $" — {node.ShortDefinition}" : "")
                        @if (outgoing.Count > 0)
                        {
                            <ul>
                                @foreach (var edge in outgoing)
                                {
                                    var target = Model.Nodes.FirstOrDefault(n => n.Id == edge.ToId);
                                    <li>@(edge.Label ?? "свързано с") → @(target?.Label ?? edge.ToId)</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </details>
    }
    else
    {
        var primary = Model.Nodes.Where(n => !n.IsCrossReference).ToList();
        var crossRefs = Model.Nodes.Where(n => n.IsCrossReference).ToList();

        <ol class="concept-graph__chain">
            @for (var i = 0; i < primary.Count; i++)
            {
                var node = primary[i];
                <li class="concept-graph__chain-node">
                    <div class="concept-graph__node concept-graph__node--@StateClass(node.DisplayState)">
                        <span class="concept-graph__node-label">@node.Label</span>
                        @if (!string.IsNullOrWhiteSpace(node.ShortDefinition))
                        {
                            <span class="concept-graph__node-definition">@node.ShortDefinition</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(node.Anchor))
                        {
                            <a class="concept-graph__node-link" href="@node.Anchor">Виж секцията →</a>
                        }
                    </div>
                </li>
                @if (i < primary.Count - 1)
                {
                    var edge = Model.Edges.FirstOrDefault(e => e.FromId == node.Id && e.ToId == primary[i + 1].Id);
                    <li class="concept-graph__chain-connector">
                        <span class="concept-graph__chain-arrow" aria-hidden="true">↓</span>
                        @if (!string.IsNullOrWhiteSpace(edge?.Label))
                        {
                            <span class="concept-graph__chain-edge-label">@edge!.Label</span>
                        }
                    </li>
                }
            }
        </ol>

        @if (crossRefs.Count > 0)
        {
            <div class="concept-graph__cross-refs">
                <p class="concept-graph__cross-refs-label">Свързано, разгърнато другаде:</p>
                <ul>
                    @foreach (var node in crossRefs)
                    {
                        var edge = Model.Edges.FirstOrDefault(e => e.ToId == node.Id);
                        <li>
                            @if (!string.IsNullOrWhiteSpace(edge?.Label))
                            {
                                <span class="concept-graph__edge-label">@edge!.Label</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(node.Anchor))
                            {
                                <a href="@node.Anchor">@node.Label</a>
                            }
                            else
                            {
                                <strong>@node.Label</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(node.ShortDefinition))
                            {
                                <span class="concept-graph__node-definition"> — @node.ShortDefinition</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        <details class="concept-graph__fallback">
            <summary>Текстово описание на картата</summary>
            <ul class="concept-graph__fallback-list">
                @foreach (var node in Model.Nodes)
                {
                    var outgoing = Model.Edges.Where(e => e.FromId == node.Id).ToList();
                    <li>
                        <strong>@node.Label</strong>@(!string.IsNullOrWhiteSpace(node.ShortDefinition) ? $" — {node.ShortDefinition}" : "")
                        @if (outgoing.Count > 0)
                        {
                            <ul>
                                @foreach (var edge in outgoing)
                                {
                                    var target = Model.Nodes.FirstOrDefault(n => n.Id == edge.ToId);
                                    <li>@(edge.Label ?? "свързано с") → @(target?.Label ?? edge.ToId)</li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        </details>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public GraphRenderModel Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ComponentId { get; set; } = default!;

    private string _titleId => $"{ComponentId}-title";

    private string ModeClass => Model.Mode switch
    {
        ConceptGraphMode.MindMap => "mindmap",
        ConceptGraphMode.ConceptMap => "conceptmap",
        ConceptGraphMode.CaseMap => "casemap",
        _ => "mindmap"
    };

    private static string StateClass(ConceptState? state) => state switch
    {
        ConceptState.Upcoming => "upcoming",
        ConceptState.Revisited => "revisited",
        ConceptState.Introduced => "introduced",
        _ => "instance"
    };
}
